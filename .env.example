# ==========================================
# VARIABLES DE ENTORNO - PARKING APP
# Copia este archivo como .env y ajusta los valores.
# ==========================================

# Base de datos PostgreSQL
POSTGRES_DB=parking_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_password

# Base de datos MySQL
MYSQL_DATABASE=parking_events
MYSQL_ROOT_PASSWORD=cambia_esta_password

# Firma JWT compartida entre microservicios
JWT_SECRET=cambia_esta_firma_secreta_por_una_larga_y_aleatoria

# CI/CD y alertas.
# En el repositorio remoto configuralos en: Settings > Secrets and variables > Actions
SONAR_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=